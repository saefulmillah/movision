# Base URL yang dipakai frontend untuk memanggil backend.
# Kosongkan / biarkan "/api" saat dev agar lewat proxy Vite (lihat vite.config.ts).
VITE_API_BASE_URL=/api

# Target proxy Vite saat dev (dipakai vite.config.ts, bukan di browser).
VITE_API_PROXY_TARGET=http://localhost:3000

# Origin backend untuk aset statis (mis. /static/vehicle-types/*.svg dari payload).
# Kosongkan saat dev → otomatis pakai VITE_API_PROXY_TARGET. Isi origin backend di produksi.
VITE_BACKEND_URL=

# Google Maps JS API key — dipakai pada fase layar Peta (belum aktif di kerangka).
VITE_GOOGLE_MAPS_API_KEY=
